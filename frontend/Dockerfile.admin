# syntax=docker/dockerfile:1.7
FROM node:22.22.3-alpine AS build
WORKDIR /workspace
COPY package.json ./
RUN --mount=type=cache,id=marketplace-npm-cache,target=/root/.npm,sharing=shared \
    npm install --no-audit --no-fund
COPY angular.json tsconfig.json ./
COPY projects ./projects
COPY shared ./shared
RUN npx ng build admin --configuration production
RUN mkdir -p /out && cp -R dist/admin/browser/. /out/

FROM nginx:1.27-alpine
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /out /usr/share/nginx/html
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -q -O- http://127.0.0.1/health || exit 1
