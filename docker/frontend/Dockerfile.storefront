FROM node:22-alpine AS build
WORKDIR /workspace
COPY frontend/package.json frontend/angular.json frontend/tsconfig.json ./
COPY frontend/projects ./projects
COPY frontend/shared ./shared
RUN npm install --no-audit --no-fund
RUN npx ng build storefront --configuration production
RUN mkdir -p /out && cp -R dist/storefront/browser/. /out/

FROM nginx:1.27-alpine
COPY frontend/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY frontend/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /out /usr/share/nginx/html
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -q -O- http://127.0.0.1/health || exit 1
