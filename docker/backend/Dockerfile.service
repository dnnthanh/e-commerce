# syntax=docker/dockerfile:1.7
FROM maven:3.9.11-eclipse-temurin-25 AS build
ARG MODULE
WORKDIR /workspace
COPY backend ./backend
RUN --mount=type=cache,id=marketplace-maven-repository,target=/root/.m2,sharing=shared \
    test -n "$MODULE" \
 && mvn -B -ntp -f backend/pom.xml \
      -Daether.connector.http.retryHandler.count=8 \
      -Daether.connector.http.retryHandler.interval=2000 \
      -Daether.connector.http.retryHandler.intervalMax=30000 \
      -pl "services/${MODULE}" -am -DskipTests package \
 && JAR="$(find "backend/services/${MODULE}/target" -maxdepth 1 -type f -name '*.jar' ! -name '*.original' | head -n 1)" \
 && test -n "$JAR" \
 && cp "$JAR" /workspace/app.jar

FROM eclipse-temurin:25-jre
WORKDIR /app
RUN useradd --system --uid 10001 marketplace
COPY --from=build /workspace/app.jar /app/app.jar
COPY docker/backend/service-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && chown -R marketplace:marketplace /app
USER marketplace
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
